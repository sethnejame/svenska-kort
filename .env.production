# The API origin, bundled into the production build.
#
# This is public by design and is the only environment value the app reads. It
# is NOT a secret: the repo is public and this string ships to every browser.
#
# Empty until the Worker is deployed. Empty means `hasApi()` is false and the
# app is exactly the fully-local phase 2 build, which is the correct default
# until P15 does the cutover.
#
# Fill in with the deployed Worker origin, no trailing slash, e.g.
#   VITE_API_BASE=https://svenska-kort-api.<your-subdomain>.workers.dev
VITE_API_BASE=
